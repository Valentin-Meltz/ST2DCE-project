{
  "name": "task-api",
  "version": "1.0.0",
  "description": "Minimal task REST API backed by PostgreSQL, instrumented for operations (health, Prometheus metrics, JSON logs).",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "pretest:ci": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\"",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml \"test/unit/**/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-reporter=spec \"test/integration/**/*.test.js\"",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supertest": "7.3.2"
  }
}
